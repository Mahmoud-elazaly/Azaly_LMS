# Generate a different URL-safe password for each role with openssl rand -hex 32.
POSTGRES_PASSWORD=
POSTGRES_READER_PASSWORD=

# Required to enable authentication. Use an HTTPS origin except on local loopback.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
AUTH_DATABASE_URL=

# Separate authoring login, provisioned after Phase 3 migrations.
AUTHORING_DATABASE_URL=

# Separate learner login, provisioned after Phase 4 migrations.
LEARNER_DATABASE_URL=

# Invitation mail. Use a verified sender address with the Resend API or a compatible HTTPS relay.
INVITATION_MAIL_API_KEY=
INVITATION_MAIL_FROM=
INVITATION_MAIL_URL=https://api.resend.com/emails
