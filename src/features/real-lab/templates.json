{
  "nginx-reverse-proxy@1": {
    "track": "web-proxy",
    "checkerVersion": "nginx-route@1",
    "starter": "green",
    "target": "blue",
    "configurations": {
      "green": "proxy_pass http://127.0.0.1:8082;",
      "blue": "proxy_pass http://127.0.0.1:8081;"
    },
    "previews": {
      "green": "upstream-green",
      "blue": "upstream-blue"
    }
  },
  "linux-file-permissions@1": {
    "track": "linux-os",
    "checkerVersion": "linux-umask@1",
    "starter": "default",
    "target": "private",
    "configurations": {
      "default": "umask 022",
      "private": "umask 077"
    },
    "previews": {
      "default": "mode=644 owner=101",
      "private": "mode=600 owner=101"
    }
  },
  "prometheus-exposition@1": {
    "track": "observability",
    "checkerVersion": "prometheus-exposition@1",
    "starter": "staging",
    "target": "production",
    "configurations": {
      "staging": "environment=staging",
      "production": "environment=production"
    },
    "previews": {
      "staging": "# TYPE checkout_requests_total counter\ncheckout_requests_total{environment=\"staging\"} 7",
      "production": "# TYPE checkout_requests_total counter\ncheckout_requests_total{environment=\"production\"} 7"
    }
  }
}
